<Window x:Class="PoGoCoinBagWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PoGo Coin Bag - Switch Emulator" 
        Height="620" Width="460"
        WindowStartupLocation="CenterScreen"
        Background="#0F1117"
        Foreground="#ECEFF4"
        FontFamily="Segoe UI, Segoe UI Variable, sans-serif"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3B82F6"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#2E3440"/>
                    <Setter Property="Foreground" Value="#6B7280"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#1F2430"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D3748"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1A202C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="ToggleOnButton" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#059669"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#10B981"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#047857"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Bluetooth Hardware Status Card -->
            <RowDefinition Height="*"/>    <!-- Guide / Steps -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="🪙" FontSize="26" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="PoGo Coin Bag" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Nintendo Switch Postcard Receiver Assistant" 
                       FontSize="13" 
                       Foreground="#94A3B8" 
                       HorizontalAlignment="Center" 
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Bluetooth Status Card -->
        <Border Grid.Row="1" Background="#161A23" CornerRadius="12" Padding="18" Margin="0,0,0,18" BorderBrush="#232936" BorderThickness="1">
            <StackPanel>
                <!-- Card Header -->
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Ellipse x:Name="StatusIndicatorDot" Width="12" Height="12" Fill="#EAB308" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Estado do Bluetooth" FontWeight="SemiBold" FontSize="14" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="BtnRefresh" Content="↻ Atualizar" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="12" DockPanel.Dock="Right" Click="BtnRefresh_Click"/>
                </DockPanel>

                <!-- Detailed Status Info -->
                <Border Background="#1C2230" CornerRadius="8" Padding="12" Margin="0,14,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Adaptador / Driver:" Foreground="#94A3B8" FontSize="13"/>
                            <TextBlock x:Name="TxtAdapterName" Text="A verificar..." Foreground="#F8FAFC" FontWeight="Medium" FontSize="13" Grid.Column="1" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Estado do Rádio:" Foreground="#94A3B8" FontSize="13"/>
                            <TextBlock x:Name="TxtRadioStatus" Text="A verificar..." Foreground="#F8FAFC" FontWeight="Bold" FontSize="13" Grid.Column="1" TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Action Bar for Bluetooth -->
                <StackPanel x:Name="BluetoothActionsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <Button x:Name="BtnTurnOn" Content="⚡ Ligar Bluetooth" Style="{StaticResource ToggleOnButton}" Margin="0,0,8,0" Visibility="Collapsed" Click="BtnTurnOn_Click"/>
                    <Button x:Name="BtnOpenSettings" Content="⚙️ Abrir Definições do Windows" Style="{StaticResource SecondaryButton}" Click="BtnOpenSettings_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Step-by-step & Browser Launch Section -->
        <Border Grid.Row="2" Background="#161A23" CornerRadius="12" Padding="18" BorderBrush="#232936" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Como Receber o Coin Bag" FontWeight="SemiBold" FontSize="14" Foreground="#F1F5F9" Margin="0,0,0,10"/>

                    <!-- Step 1 -->
                    <Border Background="#1C2230" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="1. No Pokémon GO (Telemóvel)" FontWeight="Bold" FontSize="12" Foreground="#38BDF8"/>
                            <TextBlock Text="Abre Definições → Dispositivos Ligados → Nintendo Switch → Conectar à Nintendo Switch (ou envia um postal do Livro de Postais)." 
                                       TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0" LineHeight="17"/>
                        </StackPanel>
                    </Border>

                    <!-- Step 2 -->
                    <Border Background="#1C2230" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="2. No Computador (Web Bluetooth)" FontWeight="Bold" FontSize="12" Foreground="#38BDF8"/>
                            <TextBlock Text="Clica no botão abaixo para abrir a consola Web no Chrome/Edge. Carrega em Connect e escolhe o teu telemóvel para receber o postal instantaneamente!" 
                                       TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0" LineHeight="17"/>
                        </StackPanel>
                    </Border>

                    <!-- Web app launcher button -->
                    <Button x:Name="BtnOpenWebApp" Content="🚀 Abrir Consola Web (Receber Postal)" Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" Margin="0,2,0,0" Click="BtnOpenWebApp_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="3" 
                   Text="PoGo Coin Bag Desktop • Suporta Windows 10/11 com Web Bluetooth" 
                   FontSize="11" 
                   Foreground="#64748B" 
                   HorizontalAlignment="Center" 
                   Margin="0,14,0,0"/>
    </Grid>
</Window>
