<Window x:Class="PoGoCoinBagWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PoGo Coin Bag - Nintendo Switch Emulator" 
        Height="780" Width="960"
        MinHeight="680" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#0B0D14"
        Foreground="#ECEFF4"
        FontFamily="Segoe UI, Segoe UI Variable, sans-serif"
        Icon="app.ico">
    <Window.Resources>
        <!-- Primary Action Button -->
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#60A5FA"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#262C3A"/>
                    <Setter Property="Foreground" Value="#64748B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button -->
        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#1E2433"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D3748"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1A202C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Danger/Cancel Button -->
        <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="#7F1D1D"/>
            <Setter Property="Foreground" Value="#FECACA"/>
            <Setter Property="BorderBrush" Value="#991B1B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#991B1B"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Green Switch Toggle Button -->
        <Style TargetType="Button" x:Key="GreenButton" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#059669"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#10B981"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#047857"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Bluetooth Status Alert Banner -->
            <RowDefinition Height="*"/>    <!-- Main Split Columns -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 1. Header with Logo & Title -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Image Source="app.ico" Width="44" Height="44" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🪙 PoGo Coin Bag" FontSize="26" FontWeight="ExtraBold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Emulador Autónomo de Nintendo Switch para Pokémon GO" FontSize="13" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button x:Name="BtnOpenSettings" Content="⚙️ Definições do Windows" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnOpenSettings_Click"/>
                <Button x:Name="BtnRefreshStatus" Content="↻ Atualizar Hardware" Style="{StaticResource SecondaryButton}" Click="BtnRefreshStatus_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- 2. Bluetooth Hardware Diagnostic Bar -->
        <Border Grid.Row="1" Background="#161B26" CornerRadius="12" Padding="16,14" Margin="0,0,0,20" BorderBrush="#262F40" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="StatusDot" Width="14" Height="14" Fill="#EAB308" Margin="0,0,14,0" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Adaptador Bluetooth: " Foreground="#94A3B8" FontSize="13"/>
                        <TextBlock x:Name="TxtAdapterName" Text="A verificar drivers..." FontWeight="SemiBold" Foreground="#F8FAFC" FontSize="13"/>
                        <TextBlock Text=" • Estado: " Foreground="#94A3B8" FontSize="13" Margin="8,0,0,0"/>
                        <TextBlock x:Name="TxtRadioStatus" Text="A verificar rádio..." FontWeight="Bold" Foreground="#FACC15" FontSize="13"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtStatusHint" Text="O Bluetooth nativo do Windows será usado para a comunicação direta com o Pokémon GO." Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>

                <Button x:Name="BtnTurnOnBluetooth" Grid.Column="2" Content="⚡ Ligar Bluetooth" Style="{StaticResource GreenButton}" Padding="16,8" FontSize="13" Visibility="Collapsed" Click="BtnTurnOnBluetooth_Click"/>
            </Grid>
        </Border>

        <!-- 3. Main Workspace: Two Columns (Left: Instructions & Action, Right: Live Activity Log) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Instructions and Big Connect Action -->
            <Border Grid.Column="0" Background="#141824" CornerRadius="14" Padding="24" BorderBrush="#222B3D" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Como Usar no Pokémon GO" FontSize="17" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,0,0,16"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <!-- Card Step 1 -->
                            <Border Background="#1C2333" CornerRadius="10" Padding="16" Margin="0,0,0,14" BorderBrush="#2E384D" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Opção A: Primeiro Emparelhamento" FontWeight="Bold" FontSize="14" Foreground="#38BDF8"/>
                                    <TextBlock Text="1. No telemóvel, abre o Pokémon GO → Poké Ball → Definições." FontSize="13" Foreground="#CBD5E1" Margin="0,6,0,0"/>
                                    <TextBlock Text="2. Toca em Dispositivos Ligados → Nintendo Switch → Conectar à Nintendo Switch." FontSize="13" Foreground="#CBD5E1" Margin="0,3,0,0"/>
                                    <TextBlock Text="3. Clica no botão azul 'Conectar e Receber' abaixo." FontSize="13" Foreground="#FCD34D" FontWeight="Medium" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card Step 2 -->
                            <Border Background="#1C2333" CornerRadius="10" Padding="16" Margin="0,0,0,14" BorderBrush="#2E384D" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Opção B: Enviar Postal Diário (Ativar Coin Bag)" FontWeight="Bold" FontSize="14" Foreground="#34D399"/>
                                    <TextBlock Text="1. No Pokémon GO, abre a Mochila → Livro de Postais." FontSize="13" Foreground="#CBD5E1" Margin="0,6,0,0"/>
                                    <TextBlock Text="2. Abre qualquer postal e toca no menu (três barras) → Enviar para a Nintendo Switch." FontSize="13" Foreground="#CBD5E1" Margin="0,3,0,0"/>
                                    <TextBlock Text="3. Clica no botão azul 'Conectar e Receber' abaixo." FontSize="13" Foreground="#FCD34D" FontWeight="Medium" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#2A1B16" CornerRadius="10" Padding="12" BorderBrush="#5E2C1A" BorderThickness="1">
                                <TextBlock Text="⚠️ Aviso: Se utilizas um autocatcher (ex: Pokémon GO Plus), desativa-o temporariamente antes de transferir." 
                                           FontSize="12" Foreground="#FDBA74" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Big Action Section -->
                    <StackPanel Grid.Row="2" Margin="0,18,0,0">
                        <Button x:Name="BtnConnect" Content="📡 Conectar e Receber" Style="{StaticResource ActionButton}" Height="54" FontSize="16" Click="BtnConnect_Click"/>
                        <Button x:Name="BtnCancel" Content="⏹️ Cancelar Operação" Style="{StaticResource DangerButton}" Height="40" Margin="0,8,0,0" Visibility="Collapsed" Click="BtnCancel_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Column: Live Status & Communication Logs -->
            <Border Grid.Column="2" Background="#141824" CornerRadius="14" Padding="20" BorderBrush="#222B3D" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
                        <TextBlock Text="Consola de Comunicação" FontSize="16" FontWeight="Bold" Foreground="#F1F5F9" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <Button Content="Limpar" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" DockPanel.Dock="Right" Click="BtnClearLog_Click"/>
                    </DockPanel>

                    <!-- Active state banner -->
                    <Border Grid.Row="1" x:Name="StateBanner" Background="#1B2232" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#2C384E" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="TxtStateHeadline" Text="Pronto a Conectar" FontWeight="Bold" FontSize="14" Foreground="#38BDF8"/>
                            <TextBlock x:Name="TxtStateDetail" Text="Clica no botão 'Conectar e Receber' quando estiveres no jogo." FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Terminal-like Log view -->
                    <Border Grid.Row="2" Background="#0C0E14" CornerRadius="8" Padding="12" BorderBrush="#1C2333" BorderThickness="1">
                        <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="TxtLog" 
                                     IsReadOnly="True" 
                                     Background="Transparent" 
                                     Foreground="#10B981" 
                                     BorderThickness="0" 
                                     FontFamily="Consolas, Cascadia Code, monospace" 
                                     FontSize="12" 
                                     TextWrapping="Wrap"
                                     Text="[Sistema] Aplicação pronta. Aguardando comando...&#x0a;"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Footer -->
        <TextBlock Grid.Row="3" 
                   Text="PoGo Coin Bag v1.1 • Comunicação BLE Direta com o Sistema Windows (Totalmente Independente da Web)" 
                   FontSize="12" 
                   Foreground="#475569" 
                   HorizontalAlignment="Center" 
                   Margin="0,16,0,0"/>
    </Grid>
</Window>
